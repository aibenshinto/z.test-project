{
  "manifest_version": 3,
  "name": "AutoApply",
  "version": "0.2.0",
  "description": "Resume-driven job search and application assistant for Naukri and LinkedIn.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.naukri.com/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "action": {
    "default_title": "AutoApply"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.naukri.com/*"
      ],
      "js": [
        "src/content/shared/highlight.js",
        "src/content/shared/interaction-core-bridge.js",
        "src/content/shared/observer-core.js",
        "src/content/shared/pointer-actions.js",
        "src/content/shared/diagnostics.js",
        "src/content/shared/executor-core.js",
        "src/content/shared/agent-loop-core.js",
        "src/content/naukri/selectors.js",
        "src/content/naukri/typing.js",
        "src/content/naukri/scrape.js",
        "src/content/naukri/observer.js",
        "src/content/naukri/executor.js",
        "src/content/naukri/agent-loop.js",
        "src/content/naukri/apply.js",
        "src/content/naukri/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "src/content/shared/highlight.js",
        "src/content/shared/interaction-core-bridge.js",
        "src/content/shared/observer-core.js",
        "src/content/shared/pointer-actions.js",
        "src/content/shared/diagnostics.js",
        "src/content/shared/executor-core.js",
        "src/content/shared/agent-loop-core.js",
        "src/content/linkedin/selectors.js",
        "src/content/linkedin/scrape.js",
        "src/content/linkedin/observer.js",
        "src/content/linkedin/executor.js",
        "src/content/linkedin/agent-loop.js",
        "src/content/linkedin/apply.js",
        "src/content/linkedin/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
